{
  "name": "Media Key Bindings",
  "description": "Adds key bindings for videos",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Media Key Bindings",
    "default_popup": "popup.html",
    "default_icon": "dial_icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
